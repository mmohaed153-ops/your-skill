        "latestBackupAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "VaultVersion": {
      "title": "VaultVersion",
      "description": "A versioned snapshot backup belonging to a VaultProject.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "projectId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "versionNumber": {
          "type": "integer"
        },
        "versionLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "notes": {
          "type": "string",
          "maxLength": 600
        },
        "totalSizeBytes": {
          "type": "integer"
        },
        "files": {
          "type": "array",
          "description": "Attached project files metadata (bounded list up to 100)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "projectId",
        "ownerId",
        "versionNumber",
        "versionLabel",
        "notes",
        "totalSizeBytes",
        "files",
        "createdAt",
        "updatedAt"
      ]
    },
    "LibraryAsset": {
      "title": "LibraryAsset",
