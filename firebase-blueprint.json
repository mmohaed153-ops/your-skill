{
  "entities": {
    "LearningPath": {
      "title": "LearningPath",
      "description": "A personalized video learning path created by a learner.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the learning path.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the user who owns this learning path.",
          "minLength": 1,
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Arabic or English title of the learning path.",
          "minLength": 1,
          "maxLength": 160
        },
        "description": {
          "type": "string",
          "description": "Short summary describing the goal of the learning path.",
          "maxLength": 600
        },
        "coverImage": {
          "type": "string",
          "description": "Cover image path, URL, or compressed data URL.",
          "maxLength": 350000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": ["id", "ownerId", "title", "description", "coverImage", "createdAt", "updatedAt"]
    },
    "VideoStep": {
      "title": "VideoStep",
      "description": "An ordered video step inside a personalized learning path.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the video step.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "pathId": {
          "type": "string",
          "description": "Parent learning path identifier.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the path owner.",
          "minLength": 1,
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "description": "Title of the video lesson.",
          "minLength": 1,
          "maxLength": 180
        },
        "description": {
          "type": "string",
          "description": "Short description or study notes for the video.",
          "maxLength": 1000
        },
        "videoUrl": {
          "type": "string",
          "description": "Original video link (YouTube, Vimeo, or direct video URL).",
          "minLength": 1,
          "maxLength": 2048
        },
        "thumbnailUrl": {
          "type": "string",
          "description": "Thumbnail image path, URL, or compressed data URL.",
          "maxLength": 350000
        },
        "order": {
          "type": "integer",
          "description": "Zero-based position of the video in the learning path."
        },
        "completed": {
          "type": "boolean",
          "description": "Whether the learner has marked this video step as completed."
        },
        "completedAt": {
          "type": "string",
          "description": "ISO timestamp when the step was completed, or empty string.",
          "maxLength": 64
        },
        "targetDate": {
          "type": "string",
          "description": "Optional daily schedule or target date (YYYY-MM-DD).",
          "maxLength": 40
        },
        "quickNotes": {
          "type": "string",
          "description": "Personal study quick notes saved by the learner inside the watch modal for this video step.",
          "maxLength": 3000
        },
        "quickNotesUpdatedAt": {
          "type": "string",
          "description": "ISO timestamp when quick notes were last saved, or empty string.",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp."
        }
      },
      "required": [
        "id",
        "pathId",
        "ownerId",
        "title",
        "description",
        "videoUrl",
        "thumbnailUrl",
        "order",
        "completed",
        "completedAt",
        "targetDate",
        "createdAt",
        "updatedAt"
      ]
    },
